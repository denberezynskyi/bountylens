{
  "expo": {
    "name": "BountyLens",
    "slug": "bountylens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bountylens",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bountylens.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BountyLens needs camera access to capture photo proof when completing bounties.",
        "NSLocationWhenInUseUsageDescription": "BountyLens needs your location to verify your proximity to target bounties on the radar."
      }
    },
    "android": {
      "package": "com.bountylens.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BountyLens to access your camera to capture proof of bounty completion."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BountyLens to access your location to verify target discovery and drop proximity."
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6d72869-e774-4e18-a125-e60d67b83846"
      }
    }
  }
}
