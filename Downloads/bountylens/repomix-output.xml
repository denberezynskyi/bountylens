    elevation: 4,
  },
  markerIconScout: {
    borderColor: '#006C49',
  },
  markerIconScoutActive: {
    backgroundColor: '#006C49',
    borderColor: '#10B981',
  },
  markerIconCreator: {
    borderColor: '#D97706',
  },
  markerIconCreatorActive: {
    backgroundColor: '#D97706',
    borderColor: '#F59E0B',
  },
