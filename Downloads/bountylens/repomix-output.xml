  proofImage?: string | null;
  durationMinutes?: number;
}

interface BountiesContextType {
  bounties: BountyItem[];
  completedBounties: BountyItem[];
  fetchBounties: () => Promise<void>;
  resetBounties: () => Promise<void>;
  isLoading: boolean;
}

const BountiesContext = createContext<BountiesContextType | undefined>(undefined);

export const BountiesProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [bounties, setBounties] = useState<BountyItem[]>([]);
  const [completedBounties, setCompletedBounties] = useState<BountyItem[]>([]);
  const [isLoading, setIsLoading] = useState<boolean>(true);

  // Конвертація рядка з БД в модель інтерфейсу
  const mapDbToBounty = (row: any): BountyItem => {
    const expiresAt = row.expires_at ? new Date(row.expires_at).getTime() : Date.now() + 1800 * 1000;
    const now = Date.now();
    const remainingSeconds = Math.max(0, Math.floor((expiresAt - now) / 1000));

    const finalReward = row.reward !== undefined && row.reward !== null
      ? Number(row.reward)
      : row.reward_cents !== undefined && row.reward_cents !== null
      ? Number(row.reward_cents) / 100
      : 5.0;

    return {
      id: String(row.id),
      title: row.title || row.description || 'Verified Spot',
      place: row.place || row.address || 'City Location',
      address: row.address || row.place || 'City Location',
      category: row.category || 'coffee',
      reward: finalReward,
      xp: row.xp ? Number(row.xp) : Math.round(finalReward * 10),
      expiresInSeconds: remainingSeconds,
      latitude: Number(row.latitude) || 50.7472,
      longitude: Number(row.longitude) || 25.3254,
      difficulty: row.difficulty || 'Quick',
      creator: row.creator || '@host',
      creator_id: row.creator_id ? String(row.creator_id) : undefined,
      completed: row.status === 'completed',
      proofImage: row.proof_image || null,
    };
  };

  // Завантаження завдань із Supabase
  const fetchBounties = async () => {
    try {
      setIsLoading(true);
      const { data, error } = await supabase
        .from('bounties')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        console.error('Error fetching bounties:', error);
        return;
      }

      if (data) {
        const active = data.filter((item) => item.status === 'active').map(mapDbToBounty);
        const completed = data.filter((item) => item.status === 'completed').map(mapDbToBounty);
        setBounties(active);
        setCompletedBounties(completed);
      }
    } catch (e) {
      console.warn('Network error fetching bounties:', e);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchBounties();

    const channel = supabase
      .channel('realtime_bounties')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'bounties' },
        (payload) => {
          if (payload.eventType === 'INSERT') {
            const newItem = mapDbToBounty(payload.new);
            setBounties((prev) => [newItem, ...prev.filter((b) => b.id !== newItem.id)]);
          } else if (payload.eventType === 'UPDATE') {
            const updated = mapDbToBounty(payload.new);
            if (updated.completed) {
              setBounties((prev) => prev.filter((b) => b.id !== updated.id));
              setCompletedBounties((prev) => [updated, ...prev.filter((b) => b.id !== updated.id)]);
            } else {
              setBounties((prev) => prev.map((b) => (b.id === updated.id ? updated : b)));
            }
          } else if (payload.eventType === 'DELETE') {
            setBounties((prev) => prev.filter((b) => b.id !== String(payload.old.id)));
          }
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, []);

  // Таймер зворотного відліку
  useEffect(() => {
    const timer = setInterval(() => {
      setBounties((prev) =>
        prev
          .map((b) => ({
            ...b,
            expiresInSeconds: Math.max(0, b.expiresInSeconds - 1),
          }))
          .filter((b) => b.expiresInSeconds > 0)
      );
    }, 1000);

    return () => clearInterval(timer);
  }, []);

  const resetBounties = async () => {
    await fetchBounties();
  };

  return (
    <BountiesContext.Provider
      value={{
        bounties,
        completedBounties,
        fetchBounties,
        resetBounties,
        isLoading,
      }}
    >
      {children}
    </BountiesContext.Provider>
  );
};

export const useBounties = () => {
  const context = useContext(BountiesContext);
  if (!context) {
    throw new Error('useBounties must be used within a BountiesProvider');
  }
  return context;
};
</file>

<file path="context/UserContext.tsx">
import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { supabase } from '../lib/supabase';
import { getOrCreateScoutId } from '../lib/authHelper';

export type UserRole = 'scout' | 'creator';

export interface WalletTransaction {
  id: string;
  type: 'earned' | 'payout' | 'deposit' | 'escrow_hold' | 'refund';
  amount: number;
  title: string;
  place?: string;
  timestamp: number;
  status: 'completed' | 'processing';
}

interface UserContextType {
  balance: number;
  xp: number;
  level: number;
  tasksCompleted: number;
  role: UserRole;
  transactions: WalletTransaction[];
  hasCompletedOnboarding: boolean;
  isLoadingUser: boolean;
  userId: string | null;
  userEmail: string | null;
  completeOnboarding: (chosenRole: UserRole) => Promise<void>;
  setRole: (role: UserRole) => Promise<void>;
  refreshUserData: () => Promise<void>;
  logout: () => Promise<void>;
}

const UserContext = createContext<UserContextType | undefined>(undefined);

export const UserProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [balance, setBalance] = useState<number>(0.0);
  const [xp, setXp] = useState<number>(0);
  const [tasksCompleted, setTasksCompleted] = useState<number>(0);
  const [transactions, setTransactions] = useState<WalletTransaction[]>([]);
  const [role, setRoleState] = useState<UserRole>('scout');
  const [hasCompletedOnboarding, setHasCompletedOnboarding] = useState<boolean>(false);
  const [isLoadingUser, setIsLoadingUser] = useState<boolean>(true);
  const [userId, setUserId] = useState<string | null>(null);
  const [userEmail, setUserEmail] = useState<string | null>(null);

  const level = Math.max(1, Math.floor(xp / 200) + 1);

  const fetchUserData = useCallback(async () => {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const currentUid = session?.user?.id || (await getOrCreateScoutId());

      if (currentUid) {
        setUserId(currentUid);
        if (session?.user?.email) setUserEmail(session.user.email);

        // Читаємо транзакції поточного користувача
        const { data: txData, error: txError } = await supabase
          .from('transactions')
          .select('id, amount, amount_cents, type, title, place, created_at')
          .eq('user_id', currentUid)
          .order('created_at', { ascending: false });

        if (!txError && txData) {
          let calculatedCents = 0;
          const mappedTxs: WalletTransaction[] = txData.map((tx: any) => {
            const cents = tx.amount_cents !== undefined && tx.amount_cents !== null
              ? tx.amount_cents
              : Math.round((Number(tx.amount) || 0) * 100);

            calculatedCents += cents;

            const isIncome = cents > 0;
            return {
              id: tx.id,
              type: isIncome ? 'earned' : 'payout',
              amount: Math.abs(cents) / 100,
              title: tx.title || (isIncome ? 'Ground Verification Payout' : 'Escrow Hold / Withdrawal'),
              place: tx.place || 'Verified Drop Location',
              timestamp: new Date(tx.created_at).getTime(),
              status: 'completed',
            };
          });

          setBalance(Math.max(0, calculatedCents / 100));
          setTransactions(mappedTxs);
        }

        // Кількість верифікованих сабмітів скаута
        const { count } = await supabase
          .from('submissions')
          .select('id', { count: 'exact', head: true })
          .eq('scout_id', currentUid)
          .eq('status', 'approved');

        if (count !== null && count !== undefined) {
          setTasksCompleted(count);
          setXp(count * 50);
        }
      }

      const savedRole = await AsyncStorage.getItem('@user_role');
      const savedOnboarding = await AsyncStorage.getItem('@user_onboarding_completed');

      if (savedRole) setRoleState(savedRole as UserRole);
      if (savedOnboarding) setHasCompletedOnboarding(savedOnboarding === 'true');
    } catch (e) {
      console.warn('Failed to sync user data with backend:', e);
    } finally {
      setIsLoadingUser(false);
    }
  }, []);

  useEffect(() => {
    fetchUserData();

    const { data: authListener } = supabase.auth.onAuthStateChange((event) => {
      if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') {
        fetchUserData();
      }
    });

    const txChannel = supabase
      .channel('realtime_transactions_sync')
      .on(
        'postgres_changes',
        { event: 'INSERT', schema: 'public', table: 'transactions' },
        () => {
          fetchUserData();
        }
      )
      .subscribe();

    return () => {
      authListener.subscription.unsubscribe();
      supabase.removeChannel(txChannel);
    };
  }, [fetchUserData]);

  const completeOnboarding = async (chosenRole: UserRole) => {
    setRoleState(chosenRole);
    setHasCompletedOnboarding(true);
    await AsyncStorage.setItem('@user_role', chosenRole);
    await AsyncStorage.setItem('@user_onboarding_completed', 'true');
  };

  const setRole = async (newRole: UserRole) => {
    setRoleState(newRole);
    await AsyncStorage.setItem('@user_role', newRole);
  };

  const logout = async () => {
    try {
      await supabase.auth.signOut();
    } catch (e) {
      console.warn('Supabase sign out error:', e);
    }

    setHasCompletedOnboarding(false);
    setBalance(0);
    setXp(0);
    setTasksCompleted(0);
    setTransactions([]);

    await AsyncStorage.multiRemove([
      '@user_onboarding_completed',
      '@user_role',
    ]);
  };

  return (
    <UserContext.Provider
      value={{
        balance,
        xp,
        level,
        tasksCompleted,
        role,
        transactions,
        hasCompletedOnboarding,
        isLoadingUser,
        userId,
        userEmail,
        completeOnboarding,
        setRole,
        refreshUserData: fetchUserData,
        logout,
      }}
    >
      {children}
    </UserContext.Provider>
  );
};

export const useUser = () => {
  const context = useContext(UserContext);
  if (!context) {
    throw new Error('useUser must be used within a UserProvider');
  }
  return context;
};
</file>

<file path="hooks/useMyBounties.ts">
import { useCallback, useEffect, useState } from 'react';
import { useFocusEffect } from 'expo-router';
import { fetchMyBounties, type MyBounty } from '@/lib/author';
import { supabase } from '@/lib/supabase';

export function useMyBounties(userId: string | null) {
  const [items, setItems] = useState<MyBounty[]>([]);
  const [loading, setLoading] = useState(true);

  const refresh = useCallback(async () => {
    if (!userId) return;
    try {
      setItems(await fetchMyBounties(userId));
    } catch (e) {
      console.warn('my-bounties', e);
    } finally {
      setLoading(false);
    }
  }, [userId]);

  useFocusEffect(useCallback(() => { refresh(); }, [refresh]));

  // статус змінюється, коли виконавець надсилає пруф
  useEffect(() => {
    if (!userId) return;
    const ch = supabase
      .channel(`my-bounties-${userId}`)
      .on('postgres_changes', { event: '*', schema: 'public', table: 'bounties', filter: `creator_id=eq.${userId}` }, () => refresh())
      .subscribe();
    return () => {
      supabase.removeChannel(ch);
    };
  }, [userId, refresh]);

  return { items, loading, refresh };
}
