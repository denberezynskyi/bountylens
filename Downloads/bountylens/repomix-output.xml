                <MaterialCommunityIcons
                  name="compass-outline"
                  size={24}
                  color={selectedRole === 'scout' ? '#006C49' : '#6C7A71'}
                />
              </View>

              <View
                style={[
                  styles.checkCircle,
                  selectedRole === 'scout'
                    ? styles.checkCircleActiveScout
                    : styles.checkCircleInactive,
