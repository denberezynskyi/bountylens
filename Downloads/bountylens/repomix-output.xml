            </Text>
          </View>
          <Text style={styles.titleText}>Join the Scout Network</Text>
          <Text style={styles.subText}>
            Choose your role to explore, verify ground spots, and earn daily rewards.
          </Text>
        </View>

        {/* Role Cards Selection */}
        <View style={styles.rolesRow}>
          {/* Scout Card */}
